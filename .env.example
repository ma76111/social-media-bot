# ─────────────────────────────────────────────
#  ملف إعدادات البوت
#  انسخ هذا الملف وسمّه  .env  ثم عدّل القيم
# ─────────────────────────────────────────────

# توكن البوت — تحصل عليه من @BotFather في تيليجرام
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# معرفات الأدمن — أرقام تيليجرام مفصولة بفاصلة
# يمكن إضافة أكثر من أدمن:  123456789,987654321
ADMIN_IDS=YOUR_TELEGRAM_ID_HERE

# اسم المستخدم للبوت بدون @ (اختياري — يُستخدم في روابط الإحالة)
# مثال: BOT_USERNAME=my_task_bot
BOT_USERNAME=

# معرف مجموعة/قناة لإشعارات طلبات السحب (اختياري)
# أرسل رسالة للمجموعة وخذ معرفها السالب، مثال: -1001234567890
WITHDRAWAL_GROUP=

# ─────────────────────────────────────────────
#  اشتراك إجباري (يمكن ضبطه من لوحة الأدمن أيضاً)
# ─────────────────────────────────────────────

# معرف القناة/المجموعة المطلوب الاشتراك فيها
# مثال: @MediaBuyer_Group  أو  -1001234567890
# ⚠️ يجب أن يكون البوت مضافاً كأدمن في القناة/المجموعة
REQUIRED_CHANNEL=@MediaBuyer_Group

# اسم القناة للعرض في رسالة الاشتراك
REQUIRED_CHANNEL_LABEL=قناة MediaBuyer

# رابط القناة للضغط عليه مباشرة
REQUIRED_CHANNEL_URL=https://t.me/MediaBuyer_Group
